# Fable+ backend — sandbox configuration.
# Copy to .env. NEVER commit real secrets (audit I37: secrets vaulted, none in repo).

PORT=8787
# Where the SQLite database file lives (used when DATABASE_URL is empty).
DATABASE_PATH=./data/fableplus.db
# Set DATABASE_URL to use Postgres instead of SQLite (recommended for scale).
# e.g. postgresql://user:pass@host:5432/fableplus
DATABASE_URL=
# Postgres connection pool size.
PG_POOL_MAX=10
# HMAC secret used to sign session cookies. Generate your own; this default is dev-only.
SESSION_SECRET=dev-only-change-me-please-32+chars
# Comma-separated allowed CORS origins (the web app).
CORS_ORIGIN=http://localhost:5173

# --- External service adapters --------------------------------------------------
# All external integrations run in SANDBOX mode by default (no live rails touched).
# Drop real *test-mode* keys in here to exercise the real providers; absent keys use
# the deterministic in-process sandbox.

# Stripe (TEST mode only). Leave blank to use the sandbox payment adapter.
STRIPE_SECRET_KEY=
# OTP delivery. "console" prints codes to the server log (sandbox). "stripe"/"twilio" reserved.
OTP_CHANNEL=console
# LLM for the grounded copilot. Leave blank to use the deterministic sandbox model.
ANTHROPIC_API_KEY=

# DVSA MOT History API (OAuth2 client-credentials). Leave blank to use the sandbox.
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
DVSA_TOKEN_URL=
# DVSA_API_BASE=https://history.mot.api.gov.uk/v1/trade/vehicles/registration
