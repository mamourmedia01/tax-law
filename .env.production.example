# Fable+ production env — copy to .env (git-ignored) and fill in. NEVER commit real values.

# Postgres password (used by db + server DATABASE_URL)
DB_PASSWORD=change-me-strong

# 32+ char random string for signing sessions
SESSION_SECRET=change-me-with-a-long-random-string

# 64 hex chars for AES-256 field encryption at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public web origin(s), comma-separated (for CORS). Include your domain + the
# Capacitor native origins for the mobile apps. Must NOT contain localhost in prod.
CORS_ORIGIN=https://app.fableplus.co.uk,capacitor://localhost,https://localhost

# Session cookie posture. Default "lax" suits a same-origin deploy (nginx serves the
# web app and proxies /api on the same domain). If the web frontend and API live on
# DIFFERENT sites, set COOKIE_SAMESITE=none (this forces Secure cookies). Native apps
# use Authorization: Bearer and don't rely on the cookie at all.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=1

# --- external integrations (test-mode keys; blank = built-in sandbox adapters) ---
STRIPE_SECRET_KEY=
ANTHROPIC_API_KEY=
VOICE_SERVICE_URL=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=
DVSA_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
